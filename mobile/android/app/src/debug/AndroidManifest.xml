<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the in-app update test reach a local test server over plain http on 127.0.0.1
     (adb reverse). Release builds keep Android's default (https only). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config_debug" />
</manifest>
