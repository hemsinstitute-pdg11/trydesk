// Name and logo for TryDesk's two helpers (trydesk-capture.exe, trydesk-service.exe). Without them, the prompts
// Windows shows about them (the firewall alert when the fast path opens its UDP port, the UAC prompt for the service)
// said "trydesk-capture.exe" with a blank icon (owner 19 Nov: "harus TryDesk ... dan harus muncul logonya").
// Built in by scripts\build-capture.cmd (rc.exe), the same for both helpers.
#include <winver.h>

1 ICON "..\\..\\assets\\icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,0,0
 PRODUCTVERSION 1,4,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DrWeabo"
      VALUE "FileDescription", "TryDesk"
      VALUE "ProductName", "TryDesk"
      VALUE "FileVersion", "1.4.0"
      VALUE "ProductVersion", "1.4.0"
      VALUE "LegalCopyright", "AGPL-3.0, DrWeabo"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
